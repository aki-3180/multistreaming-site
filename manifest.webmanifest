{
  "name": "MultiView — Twitch / YouTube / Kick",
  "short_name": "MultiView",
  "description": "Twitch・YouTube・Kickの配信を1画面で同時視聴できるマルチストリームビューア。",
  "lang": "ja",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0b0f",
